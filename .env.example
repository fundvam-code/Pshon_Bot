# Единственный файл настроек, которые меняются от компьютера к компьютеру.
# Скопируйте его в .env (в корне проекта) и заполните. Файл .env в git не попадает.
# Проверить результат: .venv32\Scripts\python.exe check_structure.py

# ---- Telegram ----
# Токен бота от @BotFather
TELEGRAM_TOKEN=

# ---- Подключение к 1С ----
# Вариант 1 (файловая база): каталог, в котором лежит файл 1Cv8.1CD
ONE_C_DB_PATH=C:\1C\Pshon

# Вариант 2 (серверная база): имя сервера 1С и имя базы в кластере.
# Если ONE_C_SERVER задан, используется этот вариант, а ONE_C_DB_PATH игнорируется.
# ONE_C_SERVER=
# ONE_C_BASE=

# Пользователь 1С с правом «Внешнее соединение» и его пароль (пароль может быть пустым)
ONE_C_USER=
ONE_C_PASSWORD=

# COM-коннектор платформы: V83.COMConnector для 8.3 (по умолчанию), V82.COMConnector для 8.2
# ONE_C_PROGID=V83.COMConnector

# ---- Необязательно ----
# Наименование валюты учёта для новых моделей/авто/запчастей (иначе берётся из существующих данных)
# ONE_C_CURRENCY=

# ФИО исполнителя по умолчанию: его бот ставит на работы в заказ-нарядах, созданных через бота.
# Должен совпадать с сотрудником в 1С (справочник «Сотрудники», признак «Исполнитель»).
# ONE_C_DEFAULT_EXECUTOR=

# Путь к списку пользователей бота (по умолчанию config/users.json относительно корня проекта)
# USERS_CONFIG=config/users.json
