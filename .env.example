# Скопируйте этот файл в .env (в корне проекта) и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Каталог файловой базы 1С (где лежит файл 1Cv8.1CD)
ONE_C_DB_PATH=C:\1C\Pshon

# Пользователь 1С с правом «Внешнее соединение» и его пароль (пароль может быть пустым)
ONE_C_USER=
ONE_C_PASSWORD=

# Необязательно: наименование валюты учёта для новых моделей/авто (иначе берётся из существующих данных)
# ONE_C_CURRENCY=

# Необязательно: путь к списку пользователей (по умолчанию config/users.json)
# USERS_CONFIG=config/users.json
